#!/usr/bin/env bash
set -euo pipefail

zero_oid=0000000000000000000000000000000000000000
snapshot_root=$(mktemp -d)
trap 'rm -rf -- "$snapshot_root"' EXIT

declare -A verified_oids=()
snapshot_number=0

while read -r local_ref local_oid _remote_ref _remote_oid; do
    if [[ "$local_oid" == "$zero_oid" || -n "${verified_oids[$local_oid]:-}" ]]; then
        continue
    fi

    if ! git cat-file -e "${local_oid}^{tree}" 2>/dev/null; then
        printf 'Cannot verify %s: %s does not identify a tree.\n' "$local_ref" "$local_oid" >&2
        exit 1
    fi

    snapshot_number=$((snapshot_number + 1))
    snapshot="$snapshot_root/$snapshot_number"
    mkdir -- "$snapshot"
    git archive --format=tar --output="$snapshot.tar" "$local_oid"
    tar -xf "$snapshot.tar" -C "$snapshot"

    printf 'Verifying %s at %s\n' "$local_ref" "$local_oid"
    (
        cd -- "$snapshot"
        bash scripts/verify.sh
    )
    verified_oids[$local_oid]=1
done
