#!/usr/bin/env bash
set -euo pipefail

git diff --cached --check

staged_shell_files=()
while IFS= read -r -d '' path; do
    staged_shell_files+=("$path")
done < <(
    git diff --cached --name-only --diff-filter=ACMR -z -- \
        '*.sh' '.githooks/pre-commit' '.githooks/pre-push'
)

if [[ ${#staged_shell_files[@]} -eq 0 ]]; then
    exit 0
fi

if ! command -v shellcheck >/dev/null 2>&1; then
    printf 'ShellCheck is required by the pre-commit hook.\n' >&2
    exit 1
fi

snapshot=$(mktemp -d)
trap 'rm -rf -- "$snapshot"' EXIT

git checkout-index --all --prefix="$snapshot/"
(
    cd -- "$snapshot"
    shellcheck "${staged_shell_files[@]}"
)
