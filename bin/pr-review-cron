#!/usr/bin/env bash
set -euo pipefail

provider="${PR_REVIEW_PROVIDER:-}"
case "$provider" in
    codex | claude | gemini) ;;
    *)
        printf 'pr-review-cron: PR_REVIEW_PROVIDER must be codex, claude, or gemini\n' >&2
        exit 2
        ;;
esac

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
export LC_ALL=C

helper="${DEV_TOOLS_HELPER:-$HOME/.bashrc.d/dev-tools-git.sh}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/pr-review"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/pr-review"
work_root="${PR_REVIEW_WORK_ROOT:-$HOME/.local/share/pr-review/work}"
log_file="$state_dir/cron.log"
state_file="$state_dir/pr-watch.seen"
owner="${PR_REVIEW_OWNER:-${PR_WATCH_OWNER:-thelarklan}}"

mkdir -p -- "$state_dir" "$cache_dir" "$work_root"
touch -- "$log_file" "$state_file"
if (( $(stat -c %s -- "$log_file") > 5242880 )); then
    tail -n 2000 -- "$log_file" >"$log_file.next"
    mv -f -- "$log_file.next" "$log_file"
fi
exec >>"$log_file" 2>&1

printf '\n[%s] %s watcher started\n' "$(date --iso-8601=seconds)" "$provider"
if [[ ! -r "$helper" ]]; then
    printf 'pr-review-cron: missing watcher helper %s\n' "$helper"
    exit 1
fi
# shellcheck source=/dev/null
source "$helper"

authenticated=$(gh api user --jq '.login') || {
    printf 'pr-review-cron: cannot read the authenticated GitHub identity\n'
    exit 1
}
reviewer="${PR_REVIEW_REVIEWER:-$authenticated}"
if [[ "${authenticated,,}" != "${reviewer,,}" ]]; then
    printf 'pr-review-cron: authenticated as %s, expected %s\n' "$authenticated" "$reviewer"
    exit 1
fi

run_dir=$(mktemp -d "$cache_dir/run.XXXXXXXX")
work_file="$run_dir/work"
error_file="$run_dir/errors"
candidate_state="$run_dir/state.seen"
before_state="$run_dir/state.before"
delta_file="$run_dir/state.delta"

cleanup() {
    rm -f -- "$work_file" "$error_file" "$candidate_state" "$before_state" "$delta_file"
    rmdir -- "${candidate_state}.lock" 2>/dev/null || true
    rmdir -- "$run_dir" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

sort -u -- "$state_file" >"$before_state"
cp -- "$before_state" "$candidate_state"

set +e
DEV_TOOLS_PR_WATCH_STATE="$candidate_state" \
PR_WATCH_OWNER="$owner" \
PR_WATCH_REVIEWER="$reviewer" \
PR_WATCH_MAX_FOLLOWUPS="${PR_REVIEW_MAX_FOLLOWUPS:-2}" \
PR_WATCH_VERBOSE=1 \
pr-watch >"$work_file" 2>"$error_file"
watch_status=$?
set -e

cat -- "$error_file"
if (( watch_status != 0 )); then
    printf 'pr-review-cron: watcher failed with status %s\n' "$watch_status"
    exit "$watch_status"
fi

sort -u -- "$candidate_state" | comm -13 "$before_state" - >"$delta_file"

commit_item_state() {
    local item="$1"
    awk -v prefix="$item " 'index($0, prefix) == 1' "$delta_file" >>"$state_file"
    sort -u -o "$state_file" -- "$state_file"
}

latest_review() {
    local repo="$1" number="$2"
    gh api --paginate "/repos/$repo/pulls/$number/reviews?per_page=100" \
        --jq ".[] | select(((.user.login // \"\") | ascii_downcase) == \"${reviewer,,}\" and (.state // \"\") != \"DISMISSED\") | [(.id | tostring), (.commit_id // \"\")] | @tsv" \
        | tail -n 1
}

resolve_executable() {
    local configured="$1" fallback="$2"
    if [[ -n "$configured" ]]; then
        if [[ "$configured" == */* ]]; then
            [[ -x "$configured" ]] || return 1
            printf '%s\n' "$configured"
        else
            command -v "$configured"
        fi
    else
        command -v "$fallback"
    fi
}

run_provider() {
    local prompt="$1" executable driver
    case "$provider" in
        codex)
            executable=$(resolve_executable "${PR_REVIEW_CODEX_BIN:-}" codex) || {
                printf 'pr-review-cron: Codex CLI is not installed\n' >&2
                return 127
            }
            timeout --signal=TERM --kill-after=2m "${PR_REVIEW_TIMEOUT:-45m}" \
                "$executable" exec --ephemeral --approve-for-me \
                --skip-git-repo-check -C "$work_root" "$prompt"
            ;;
        claude)
            executable=$(resolve_executable "${PR_REVIEW_CLAUDE_BIN:-}" claude) || {
                printf 'pr-review-cron: Claude CLI is not installed\n' >&2
                return 127
            }
            timeout --signal=TERM --kill-after=2m "${PR_REVIEW_TIMEOUT:-45m}" \
                "$executable" --print --permission-mode bypassPermissions \
                --no-session-persistence --output-format text "$prompt"
            ;;
        gemini)
            driver="${PR_REVIEW_GEMINI_DRIVER:-gemini}"
            case "$driver" in
                gemini)
                    executable=$(resolve_executable "${PR_REVIEW_GEMINI_BIN:-}" gemini) || {
                        printf 'pr-review-cron: Gemini CLI is not installed\n' >&2
                        return 127
                    }
                    timeout --signal=TERM --kill-after=2m "${PR_REVIEW_TIMEOUT:-45m}" \
                        "$executable" --prompt "$prompt" --approval-mode yolo \
                        --output-format text
                    ;;
                agy)
                    executable=$(resolve_executable "${PR_REVIEW_GEMINI_BIN:-}" agy) || {
                        printf 'pr-review-cron: Antigravity CLI (agy) is not installed\n' >&2
                        return 127
                    }
                    timeout --signal=TERM --kill-after=2m "${PR_REVIEW_TIMEOUT:-45m}" \
                        "$executable" --dangerously-skip-permissions \
                        --output-format text --print-timeout "${PR_REVIEW_TIMEOUT:-45m}" \
                        --print="$prompt"
                    ;;
                *)
                    printf 'pr-review-cron: PR_REVIEW_GEMINI_DRIVER must be gemini or agy\n' >&2
                    return 2
                    ;;
            esac
            ;;
    esac
}

processed=0
failed=0
while IFS= read -r item; do
    [[ -n "$item" ]] || continue
    if [[ ! "$item" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$ ]]; then
        printf 'pr-review-cron: refusing malformed work item: %s\n' "$item"
        failed=$((failed + 1))
        continue
    fi
    if grep -Fq "ESCALATE: $item " "$error_file"; then
        printf '[%s] %s requires human review; autonomous follow-ups stopped\n' \
            "$(date --iso-8601=seconds)" "$item"
        commit_item_state "$item"
        continue
    fi

    repo="${item%#*}"
    number="${item##*#}"
    before_review=$(latest_review "$repo" "$number")
    before_review_id="${before_review%%$'\t'*}"
    current_head=$(gh pr view "$number" --repo "$repo" --json headRefOid --jq '.headRefOid')
    prompt="$(printf '%s\n' \
        "This is an autonomous scheduled pull-request review for $item, running as GitHub identity $reviewer." \
        "" \
        "Use the GitHub CLI for GitHub reads and the final review submission. Inspect the complete diff, repository instructions, prior review conversation, and relevant surrounding code. Run proportionate tests when feasible. Re-read the pull request head immediately before submitting so no stale review is posted." \
        "" \
        "Submit exactly one new GitHub pull-request review at the current head using APPROVE, COMMENT, or REQUEST_CHANGES as warranted. Do not merely print a review locally. End the review body with this marker on its own line:" \
        "_reviewed from: $provider-wsl-cron_" \
        "" \
        "Do not merge, push commits, modify any branch, mark drafts ready, or approve a self-authored pull request. Keep temporary work under /tmp or $work_root. If a safe review cannot be completed, exit nonzero and explain why instead of submitting a guess.")"

    printf '[%s] reviewing %s at %s\n' "$(date --iso-8601=seconds)" "$item" "$current_head"
    set +e
    (cd -- "$work_root" && run_provider "$prompt")
    provider_status=$?
    set -e

    after_head=$(gh pr view "$number" --repo "$repo" --json headRefOid --jq '.headRefOid')
    after_review=$(latest_review "$repo" "$number")
    after_review_id="${after_review%%$'\t'*}"
    after_review_commit="${after_review#*$'\t'}"
    if (( provider_status == 0 )) &&
        [[ -n "$after_review_id" ]] &&
        [[ "$after_review_id" != "$before_review_id" ]] &&
        [[ "$after_review_commit" == "$after_head" ]]; then
        commit_item_state "$item"
        processed=$((processed + 1))
        printf '[%s] confirmed review %s for %s at %s\n' \
            "$(date --iso-8601=seconds)" "$after_review_id" "$item" "$after_head"
    else
        failed=$((failed + 1))
        printf 'pr-review-cron: %s was not confirmed (provider=%s, before=%s, after=%s, head=%s)\n' \
            "$item" "$provider_status" "${before_review_id:-none}" "${after_review_id:-none}" "$after_head"
    fi
done <"$work_file"

printf '[%s] %s watcher finished: %s confirmed, %s failed\n' \
    "$(date --iso-8601=seconds)" "$provider" "$processed" "$failed"
(( failed == 0 ))
